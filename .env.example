# Firebase Remote Version URL
# In Firebase Console -> Realtime Database:
# Simply store the version string or object under 'app_version':
# {
#   "version": "1.0.1"
# }
# (or simply "1.0.1")
#
# Rules for public reading:
# {
#   "rules": {
#     "app_version": {
#       ".read": true,
#       ".write": false
#     }
#   }
# }
VITE_FIREBASE_VERSION_URL=https://<YOUR-FIREBASE-PROJECT-ID>-default-rtdb.firebaseio.com/app_version.json
