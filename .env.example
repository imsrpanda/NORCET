# Firebase Remote Version URL
# Option 1: Firebase Realtime Database (Recommended - fast, lightweight, public read)
# In Firebase Console -> Realtime Database -> Create Database:
# Add a node 'app_version' with:
# {
#   "latestVersion": "1.0.1",
#   "minVersion": "1.0.0",
#   "releaseNotes": [
#     "Added AIIMS NORCET 2024 Stage I & II full question sets",
#     "Improved responsive multi-column layouts"
#   ],
#   "updateUrl": "https://github.com/imsrpanda/NORCET/releases/latest",
#   "forceUpdate": false
# }
# Set database rules to read: true for /app_version
VITE_FIREBASE_VERSION_URL=https://<YOUR-FIREBASE-PROJECT-ID>-default-rtdb.firebaseio.com/app_version.json
